// examples/hello.lum -- the smallest interesting program.
func main() -> int {
    print "Hello from Lumen";
    print "sum of 1..10 is", sum_to(10);
    return 0;
}

// Iterative factorial over an integer argument.
func sum_to(n: int) -> int {
    let total: int = 0;
    let i: int = 1;
    while i <= n {
        total += i;
        i += 1;
    }
    return total;
}